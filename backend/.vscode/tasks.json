{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "typecheck: watch",
      "type": "shell",
      "command": "npx tsc --watch --pretty false",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "group": "watchers",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "lint: watch",
      "type": "shell",
      "command": "node --watch-path=src --watch-preserve-output node_modules/eslint/bin/eslint.js --format stylish src",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "group": "watchers",
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "base": "$eslint-stylish",
        "owner": "eslint-cli",
        "source": "eslint (project)",
        "background": {
          "activeBegin": true,
          "beginsPattern": "^(Change detected|Restarting) ",
          "endsPattern": "^(Completed|Failed) running "
        }
      }
    }
  ]
}
