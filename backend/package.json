{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file=.env --watch src/server.ts ",
    "pretest": "npm run db:test:reset",
    "test": "node --env-file=.env.test --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:compose": "docker compose -f ../postgres/docker-compose.yml",
    "db:up": "npm run db:compose -- up -d --wait",
    "db:test:reset": "npm run db:compose -- exec -T db /docker-entrypoint-initdb.d/99-test-db.sh"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nanoid": "^6.0.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "ts-declaration-location": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
